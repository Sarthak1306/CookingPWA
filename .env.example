# Copy to .env and fill in. Never commit .env.

# Where nginx/certbot know this app as. Not read by the app itself, just
# documented here since it's referenced throughout deploy/.
# kitchen.sarthaksrivastava.tech

# SQLite file. Must live on a mounted volume outside the container.
KITCHEN_DB_PATH=/data/kitchen.db

# Set to "0" only for local HTTP development — must be "1" in production so
# the session cookie is never sent over plain HTTP.
KITCHEN_COOKIE_SECURE=1

# OpenRouter. Model is "provider/model-name" as OpenRouter names it,
# e.g. anthropic/claude-sonnet-5 — swappable without touching call sites.
OPENROUTER_API_KEY=
KITCHEN_MODEL_NAME=anthropic/claude-sonnet-5

# Cheaper model for the background taste-profile rewrite (P5). Falls back to
# KITCHEN_MODEL_NAME if left blank.
KITCHEN_MODEL_NAME_CHEAP=

# Hard cap on LLM calls per calendar month. A retry loop stops here, not
# when the OpenRouter balance hits zero.
KITCHEN_MONTHLY_CALL_CAP=300
